"""hitl-reserve — a generalized hardware reservation/queueing system.

Self-contained Bazel module. Vendors nothing beyond rules_go + gazelle: the Go
code is deliberately stdlib-only, so there is no go.mod dependency graph to sync
(no use_repo of Go deps). To re-vendor into another repo, `bazel_dep` on this
module (via a git_override / registry) and depend on the //api, //engine, etc.
targets, or import the Go packages directly.
"""

module(
    name = "hitl_reserve",
    version = "0.0.0",
)

bazel_dep(name = "rules_go", version = "0.53.0")
bazel_dep(name = "gazelle", version = "0.42.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.23.0")
